# keiridocs-app 環境変数サンプル
# 実際の値は .env.local（Git管理外）に設定してください。
# Vercelにデプロイする場合は同じ値をVercelのEnvironment Variablesにも登録します。

# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===== Google Gemini AI =====
GEMINI_API_KEY=
# 使用するGeminiモデル。未設定時はコード側で gemini-3.5-flash にフォールバック。
# 将来モデルを切り替える場合はこの値を変更するだけで全箇所に反映されます。
GEMINI_MODEL=gemini-3.5-flash

# ===== Dropbox =====
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# ===== Gmail（メール取込）=====
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=

# ===== LINE Bot =====
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ===== Resend（メール送信）=====
RESEND_API_KEY=

# ===== Cron（定期実行の保護）=====
CRON_SECRET=
